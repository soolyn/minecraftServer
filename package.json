{
  "name": "soolyn-launcher",
  "productName": "SoolynLauncher",
  "version": "0.1.0",
  "description": "Soolyn production Minecraft launcher",
  "author": "Soolyn",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "bundle": "node tools/fetch-bundle.cjs",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "kr.soolyn.launcher",
    "productName": "SoolynLauncher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "config/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "bundled",
        "to": "bundled"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "SoolynLauncher-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@xmcl/core": "2.16.2",
    "@xmcl/installer": "6.3.4"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  }
}
